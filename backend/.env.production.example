# Production environment variables (example only)
# Copy to .env.production on your server and set real secrets.

DATABASE_URL=postgresql://postgres.badhwkvofjzyoeuhpkhp:<YOUR-PASSWORD>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

# Keep SSL enabled for Supabase pooler
DB_SSL=true
# Supabase pooler often requires disabling cert chain verification in Node clients
DB_SSL_REJECT_UNAUTHORIZED=false

JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=1h

# Include your deployed frontend URL(s)
CORS_ORIGINS=https://your-frontend.vercel.app

# Copy on the server and fill real values:
#   cp .env.docker.example .env.docker
#   nano .env.docker
#
# Then:
#   docker compose --env-file .env.docker up -d --build
#
# Never commit .env.docker (it is gitignored).

# =============================================================================
# Public URLs (must match Cloudflare Tunnel hostnames if you use a tunnel)
# =============================================================================
# Frontend public origin (tunnel → hvac-frontend:80)
# This is the site users open in the browser — NOT the login API.
PUBLIC_SITE_URL=https://demo-hvac.pcmazing.com

# Backend public URL (tunnel → hvac-backend:3000)
# Login POST goes to ${NG_APP_API_BASE_URL}/login — this MUST be the API host.
NG_APP_API_BASE_URL=https://api-demo-hvac.pcmazing.com
API_PUBLIC_URL=https://api-demo-hvac.pcmazing.com

# Comma-separated frontend origins allowed to call the API (must include PUBLIC_SITE_URL)
CORS_ORIGINS=https://demo-hvac.pcmazing.com

# Docker network shared with Postgres / Cloudflare tunnel
# Confirm:
#   docker inspect postgres-stack-webkodex-tunnel-1 --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
# This server uses: app-tier
DOCKER_NETWORK=app-tier

# =============================================================================
# Server
# =============================================================================
NODE_ENV=production
PORT=3000

# =============================================================================
# PostgreSQL
# =============================================================================
# Prefer DATABASE_URL. Host must be reachable on DOCKER_NETWORK (app-tier).
# This server: aliases are often "db" — use that hostname, not localhost.
DATABASE_URL=postgresql://USER:PASSWORD@db:5432/hvac_warehouse

DB_HOST=db
DB_PORT=5432
DB_NAME=hvac_warehouse
DB_USER=USER
DB_PASSWORD=PASSWORD
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# If this stack still points at a managed pooler (Supabase), use SSL instead:
# DATABASE_URL=postgresql://USER:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# =============================================================================
# Auth
# =============================================================================
JWT_SECRET=change-me-jwt-long-random
JWT_EXPIRES_IN=1h
